{
  "name": "cld-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:connect": "node scripts/db/connect-test.mjs",
    "db:state": "node scripts/db/state.mjs",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:status": "node scripts/db/migrate.mjs --status",
    "db:rollback": "node scripts/db/migrate.mjs --down",
    "typecheck": "tsc --noEmit",
    "db:serve": "node scripts/db/serve.mjs",
    "db:fresh": "node scripts/db/migrate.mjs --down=99 && node scripts/db/migrate.mjs && node scripts/db/state.mjs",
    "db:responsive": "node scripts/db/write/responsive.mjs",
    "db:empty-check": "node --import ./scripts/db/alias.mjs scripts/db/empty-check.mjs",
    "db:schema": "node scripts/db/schema-check.mjs",
    "db:schema:verify": "node scripts/db/schema-check.mjs --diff=supabase/schema-census.txt",
    "clean:cache": "node -e \"require('fs').rmSync('.next/cache',{recursive:true,force:true});console.log('.next/cache removed')\"",
    "db:storage": "node scripts/db/storage-setup.mjs",
    "db:media": "node scripts/db/write/media.mjs",
    "db:refresh-check": "node scripts/db/write/refresh-check.mjs",
    "db:entities": "node scripts/db/write/entities.mjs",
    "db:sparse": "node scripts/db/write/sparse.mjs",
    "db:status-edit": "node scripts/db/write/status.mjs",
    "db:items": "node scripts/db/write/items.mjs",
    "db:feedback-order": "node --import ./scripts/db/alias.mjs scripts/db/write/feedback-order.mjs",
    "db:meetings-nullable": "node --import ./scripts/db/alias.mjs scripts/db/write/meetings-nullable.mjs",
    "db:meeting-create": "node --import ./scripts/db/alias.mjs scripts/db/write/meeting-create.mjs",
    "db:meeting-update": "node --import ./scripts/db/alias.mjs scripts/db/write/meeting-update.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
