# CLD Portal — environment template
#
# Copy to .env.local and fill in. .env.local is gitignored and must stay that
# way: every value below is a credential. None of these may ever be given a
# NEXT_PUBLIC_ prefix — that would compile them into the browser bundle.
#
#     cp .env.example .env.local

# ── Database ───────────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → Session pooler.
# Read on the server only, in src/lib/db/pool.ts, behind `server-only`.
DATABASE_URL="your-supabase-postgres-connection-string"

# ── Supabase Storage ───────────────────────────────────────────────────────
# Supabase → Project Settings → API keys → secret key (sb_secret_…).
# Uploads are server-mediated; this key never reaches the browser.
# Reading public images does not need it. Uploading does.
SUPABASE_SECRET_KEY="your-supabase-secret-key"

# Optional. Derived from DATABASE_URL when unset, which is correct for a
# standard Supabase project. Set it only for a self-hosted or proxied API.
# SUPABASE_URL="https://your-project-ref.supabase.co"

# ── Portal access ──────────────────────────────────────────────────────────
# The passphrase a person types on /login. Use a different value in each
# environment; the one in local development should never be the deployed one.
CLD_PORTAL_PASSWORD="choose-a-strong-passphrase"

# Signs the session cookie. At least 32 characters of random data — generate
# one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If this is missing or too short the portal refuses every visitor, which is
# the intended failure: the alternative is an open door onto a live database.
CLD_SESSION_SECRET="generate-a-random-48-byte-string"

# ── Optional overrides ─────────────────────────────────────────────────────
# DATABASE_POOL_MAX="5"
# CLD_CLIENT_ID="client"
