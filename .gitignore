# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which names the variables and holds none of them.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local PGlite verification database
.db/

# The archived 7Grains prototype. Kept locally as the comparison baseline for
# the original static build; nothing in the runtime imports it. Deliberately
# not published — see README. Note that scripts/db/write/media.mjs reads two
# photographs from here, so that suite only runs in a working copy that has it.
reference/
